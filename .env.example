# Copy to .env and fill in values. Used by standalone_trainer.py and Mac training scripts.
# W&B is on by default for standalone_trainer.py (pass --no-wandb to disable a run).
# After `wandb login`, WANDB_API_KEY is optional; set it here for headless/CI runs.
WANDB_API_KEY=your_api_key_here
WANDB_PROJECT=f1tenth-genesis
# WANDB_ENTITY=your_team_or_username
WANDB_MODE=online
